#include "resource.h"
#include <afxres.h>
#pragma code_page(65001)
IDD_CHAT DIALOGEX 0, 0, 700, 396
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Chat - HTTP + SSE"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Đăng xuất", IDC_DISCONNECT, 610, 6, 82, 18
    PUSHBUTTON "Làm mới", IDC_REFRESH, 520, 6, 82, 18
    LTEXT "", IDC_STATUS, 8, 9, 500, 15
    CONTROL "", IDC_USERS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 32, 150, 190
    CONTROL "", IDC_CHAT, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 165, 32, 527, 190
    LTEXT "Chọn một tin để xem đầy đủ:", -1, 8, 229, 230, 12
    EDITTEXT IDC_DETAIL, 8, 244, 684, 55, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Nội dung (tối đa 4096 byte UTF-8):", -1, 8, 306, 220, 12
    EDITTEXT IDC_INPUT, 8, 321, 595, 60, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Gửi", IDC_SEND, 614, 321, 78, 24
END

IDD_AUTH DIALOGEX 0, 0, 305, 189
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Đăng nhập"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Máy chủ", -1, 10, 13, 45, 12
    EDITTEXT IDC_IP, 60, 10, 95, 16, ES_AUTOHSCROLL
    EDITTEXT IDC_PORT, 160, 10, 40, 16, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON "Kiểm tra kết nối", IDC_CHECK, 207, 9, 88, 18
    LTEXT "Tên đăng nhập", -1, 10, 45, 78, 12
    EDITTEXT IDC_NAME, 93, 41, 202, 17, ES_AUTOHSCROLL
    LTEXT "Mật khẩu", -1, 10, 69, 78, 12
    EDITTEXT IDC_PASSWORD, 93, 65, 202, 17, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Nhập lại mật khẩu", IDC_CONFIRM_LABEL, 10, 93, 80, 12
    EDITTEXT IDC_CONFIRM, 93, 89, 202, 17, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Đăng nhập", IDC_CONNECT, 93, 115, 80, 19
    PUSHBUTTON "Tạo tài khoản", IDC_MODE, 179, 115, 116, 19
    LTEXT "", IDC_STATUS, 10, 146, 285, 34
END
